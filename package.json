{
	"name": "inreach",
	"version": "0.100.0",
	"private": true,
	"license": "GPL-3.0-only",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"build:aws": "turbo run build:aws",
		"clean": "turbo run clean:node && pnpm clean:node",
		"clean:install": "pnpm clean && pnpm install",
		"clean:node": "rm -rf ./node_modules || true",
		"db:generate": "turbo run db:generate",
		"deploy:aws": "turbo run deploy:aws",
		"dev": "tsx ./lib/devmsg.ts",
		"dev:all": "turbo run dev",
		"dev:app": "turbo run dev --filter=@weareinreach/app",
		"dev:ui": "turbo run dev --filter=@weareinreach/ui",
		"dev:web": "turbo run dev --filter=@weareinreach/web",
		"docker:down": "tsx ./docker/docker-control.ts down",
		"docker:up": "tsx ./docker/docker-control.ts up",
		"format": "turbo run format --parallel",
		"generate:data": "turbo run generate:data",
		"postinstall": "tsx ./lib/postinstall.ts",
		"knip": "knip -c ./knip.config.ts",
		"lint": "TIMING=1 turbo run lint --parallel",
		"lint:fix": "TIMING=1 turbo run lint:fix --parallel",
		"lint:pkg": "sherif -r multiple-dependency-versions",
		"lint:pkg:fix": "sherif --fix -r multiple-dependency-versions",
		"lint:staged": "lint-staged",
		"notify:install": "tsx ./lib/runInstall.ts",
		"prepare": "husky",
		"scripts:post-install": "turbo run post-install --continue",
		"test": "turbo run test",
		"test:coverage": "turbo run test:coverage",
		"test:dashboard": "(lsof -ti:4500 | xargs kill -9 2>/dev/null; tsx lib/testDashboard.ts &) && sleep 1 && open http://localhost:4500",
		"test:e2e": "turbo run test:e2e --filter=@weareinreach/app",
		"test:e2e:crud": "turbo run test:e2e:crud --filter=@weareinreach/app",
		"test:e2e:search": "turbo run test:e2e:search --filter=@weareinreach/app",
		"test:e2e:ui": "turbo run test:e2e:ui --filter=@weareinreach/app",
		"test:e2e:visual": "turbo run test:e2e:visual --filter=@weareinreach/app",
		"test:e2e:visual:update": "turbo run test:e2e:visual:update --filter=@weareinreach/app",
		"test:report": "turbo run test:report",
		"test:report:view": "turbo run test:report:view",
		"test:reports": "pnpm test:dashboard",
		"test:watch": "turbo run test:watch",
		"types:check": "turbo type-check",
		"types:sync": "typesync"
	},
	"devDependencies": {
		"@changesets/cli": "2.27.9",
		"@turbo/gen": "2.10.10",
		"@types/node": "20.17.0",
		"@types/yargs": "17.0.35",
		"@weareinreach/config": "workspace:*",
		"@weareinreach/eslint-config": "workspace:*",
		"boxen": "8.0.1",
		"docker-compose": "0.24.8",
		"dotenv": "16.4.5",
		"dotenv-expand": "11.0.6",
		"husky": "9.1.7",
		"knip": "5.34.0",
		"lint-staged": "15.2.10",
		"prettier": "3.9.6",
		"prettier-plugin-jsdoc": "1.8.1",
		"prettier-plugin-packagejson": "2.5.3",
		"prettier-plugin-prisma": "5.0.0",
		"sherif": "0.11.0",
		"tsx": "4.23.12",
		"turbo": "2.10.10",
		"typescript": "5.6.3",
		"typesync": "0.14.3",
		"yargs": "17.7.2"
	},
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": "24.x",
		"pnpm": ">=10.34.5"
	},
	"pnpm": {
		"peerDependencyRules": {
			"allowedVersions": {
				"typescript": "5",
				"webpack": "5"
			}
		},
		"onlyBuiltDependencies": [
			"@sentry/cli",
			"bufferutil",
			"esbuild",
			"msw",
			"prisma",
			"protobufjs",
			"sharp",
			"unrs-resolver"
		],
		"overrides": {
			"axios": "1.20.0",
			"better-sqlite3": "13.0.3",
			"brace-expansion@1": "1.1.20",
			"brace-expansion@2": "2.1.6",
			"brace-expansion@5": "5.0.11",
			"cross-spawn": "7.0.6",
			"deepmerge-ts": "8.0.0",
			"engine.io": "6.6.10",
			"fast-uri": "3.1.7",
			"follow-redirects": "1.16.1",
			"i18next-fs-backend": "2.6.6",
			"image-size": "2.0.3",
			"joi": "17.13.7",
			"js-yaml@3": "3.15.2",
			"js-yaml@4": "4.3.2",
			"jsonwebtoken": "9.0.0",
			"lodash": "4.18.1",
			"mysql2": "3.22.0",
			"proxy-addr": "2.0.8",
			"smol-toml": "1.7.1",
			"source-map-js": "1.2.2",
			"sourcemap-codec": "npm:@jridgewell/sourcemap-codec",
			"tmp": "0.2.7",
			"undici@7": "7.29.1",
			"undici@8": "8.10.2",
			"webpack-dev-middleware": "7.4.6",
			"ws@7": "7.5.11",
			"zod-validation-error": "4.0.2"
		},
		"patchedDependencies": {
			"@crowdin/ota-client@1.0.0": "patches/@crowdin__ota-client@1.0.0.patch",
			"json-schema-to-zod@2.8.1": "patches/json-schema-to-zod@2.8.1.patch",
			"social-links@1.15.1": "patches/social-links@1.15.1.patch"
		}
	},
	"nextBundleAnalysis": {
		"budget": 588800,
		"budgetPercentIncreaseRed": 20,
		"minimumChangeThreshold": 0,
		"showDetails": true
	}
}
